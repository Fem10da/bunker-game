ageRating: 16+
bunker:
  capacityRule: ceil_half
  description: "Покинута підземна база корпорації, що створювала динозаврів. Частина систем працює, лабораторія й зовнішні модулі пошкоджені."
cards[47]:
  - description: Відкрийте ще одну власну закриту характеристику.
    effectId: characteristic.reveal_extra
    id: open-file
    kind: action
    scope: common
    selection[1]: characteristic
    target: self
    timing: own_phase
    title: Відкрите досьє
  - description: Знову закрийте одну раніше відкриту власну характеристику.
    effectId: characteristic.hide
    id: sealed-file
    kind: action
    scope: common
    selection[1]: characteristic
    target: self
    timing: own_phase
    title: Засекречене досьє
  - description: Поміняйтеся багажем з обраним активним гравцем.
    effectId: player.swap_baggage
    id: baggage-exchange
    kind: action
    scope: common
    selection[1]: target_player
    target: any_non_afk_player
    timing: own_phase
    title: Обмін багажем
  - description: Поміняйтеся професією з обраним активним гравцем.
